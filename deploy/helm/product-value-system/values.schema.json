{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Product Value System Helm Chart Values Schema",
  "type": "object",
  "required": ["replicaCount", "image", "service", "podSecurityContext", "securityContext", "probes", "config"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "image": {
      "type": "object",
      "required": ["repository", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automountServiceAccountToken": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "runAsUser"],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "runAsUser": { "type": "integer", "minimum": 1000 },
        "runAsGroup": { "type": "integer", "minimum": 1000 },
        "fsGroup": { "type": "integer", "minimum": 1000 }
      }
    },
    "securityContext": {
      "type": "object",
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "runAsNonRoot"],
      "properties": {
        "allowPrivilegeEscalation": { "type": "boolean", "const": false },
        "readOnlyRootFilesystem": { "type": "boolean" },
        "runAsNonRoot": { "type": "boolean", "const": true },
        "runAsUser": { "type": "integer", "minimum": 1000 }
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "probes": {
      "type": "object",
      "required": ["liveness", "readiness"],
      "properties": {
        "startup": { "type": "object" },
        "liveness": {
          "type": "object",
          "required": ["path"],
          "properties": { "path": { "type": "string", "pattern": "^/" } }
        },
        "readiness": {
          "type": "object",
          "required": ["path"],
          "properties": { "path": { "type": "string", "pattern": "^/" } }
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 95 },
        "targetMemoryUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 95 }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "type": ["integer", "string"] }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowDns": { "type": "boolean" },
        "allowHttpsEgress": { "type": "boolean" }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "slo": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "window": { "type": "string", "pattern": "^[0-9]+[hdw]$" },
        "namespace": { "type": "string" },
        "labels": { "type": "object" },
        "availability": {
          "type": "object",
          "properties": {
            "target": { "type": "number", "minimum": 0.9, "maximum": 1.0 },
            "errorBudget": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 0.1 },
            "criticalErrorRate": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 }
          }
        },
        "latency": {
          "type": "object",
          "properties": {
            "p99TargetSeconds": { "type": "number", "exclusiveMinimum": 0.0 },
            "p99CriticalSeconds": { "type": "number", "exclusiveMinimum": 0.0 },
            "p95SustainedSeconds": { "type": "number", "exclusiveMinimum": 0.0 },
            "errorBudget": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 0.25 }
          }
        },
        "errorRate": {
          "type": "object",
          "properties": {
            "threshold": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 },
            "criticalThreshold": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 },
            "errorBudget": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 0.5 }
          }
        },
        "agentSuccess": {
          "type": "object",
          "properties": {
            "target": { "type": "number", "minimum": 0.5, "maximum": 1.0 },
            "criticalThreshold": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
            "errorBudget": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 0.5 }
          }
        },
        "saturation": {
          "type": "object",
          "properties": {
            "memoryThreshold": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 },
            "cpuThrottleThreshold": { "type": "number", "exclusiveMinimum": 0.0, "maximum": 1.0 }
          }
        }
      }
    },
    "otelCollector": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "sampleRate": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
        "jaeger": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "deployInstance": { "type": "boolean" },
            "strategy": { "type": "string", "enum": ["production", "allInOne"] },
            "collectorEndpoint": { "type": "string", "minLength": 1 },
            "insecure": { "type": "boolean" },
            "collectorReplicas": { "type": "integer", "minimum": 1, "maximum": 20 },
            "queryReplicas": { "type": "integer", "minimum": 1, "maximum": 10 },
            "retentionTtlSeconds": { "type": "integer", "minimum": 3600 },
            "cassandra": {
              "type": "object",
              "properties": {
                "servers": { "type": "string", "minLength": 1 },
                "keyspace": { "type": "string", "minLength": 1 },
                "replicationFactor": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          }
        }
      }
    },
    "grafanaDashboards": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "label": { "type": "string", "minLength": 1 },
        "labelValue": { "type": "string", "minLength": 1 }
      }
    },
    "vault": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "address": { "type": "string", "pattern": "^https?://" },
        "authMethod": { "type": "string", "enum": ["kubernetes", "approle", "token"] },
        "role": { "type": "string", "minLength": 1 },
        "namespace": { "type": "string" },
        "agentInject": { "type": "boolean" },
        "secretPath": { "type": "string", "minLength": 1 },
        "injectSecrets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "createDedicatedServiceAccount": { "type": "boolean" },
        "serviceAccountAnnotations": { "type": "object" }
      }
    },
    "compliance": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "retention": {
          "type": "object",
          "properties": {
            "hotStorageDays": { "type": "integer", "minimum": 1 },
            "coldStorageDays": { "type": "integer", "minimum": 1 },
            "archivalSchedule": { "type": "string", "minLength": 9 },
            "deletionSchedule": { "type": "string", "minLength": 9 }
          }
        },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": { "type": "string", "minLength": 3 },
            "region": { "type": "string", "minLength": 2 },
            "storageClass": {
              "type": "string",
              "enum": ["STANDARD", "STANDARD_IA", "GLACIER", "GLACIER_IR", "DEEP_ARCHIVE"]
            },
            "encryption": { "type": "string", "enum": ["AES256", "aws:kms"] }
          }
        },
        "cronjob": {
          "type": "object",
          "properties": {
            "successfulJobsHistoryLimit": { "type": "integer", "minimum": 1 },
            "failedJobsHistoryLimit": { "type": "integer", "minimum": 1 },
            "resources": { "type": "object" }
          }
        }
      }
    },
    "alerting": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "createSecret": { "type": "boolean" },
        "pagerduty": {
          "type": "object",
          "properties": {
            "serviceKey": { "type": "string" },
            "escalationDelayMinutes": { "type": "integer", "minimum": 1, "maximum": 120 }
          }
        },
        "slack": {
          "type": "object",
          "properties": {
            "webhookUrl": { "type": "string" },
            "criticalChannel": { "type": "string", "pattern": "^#" },
            "warningChannel": { "type": "string", "pattern": "^#" }
          }
        },
        "sendgrid": {
          "type": "object",
          "properties": {
            "apiKey": { "type": "string" },
            "toEmail": { "type": "string", "minLength": 3 }
          }
        }
      }
    },
    "loadTesting": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "isolatedNamespace": { "type": "string", "minLength": 1 },
        "replicaCount": { "type": "integer", "minimum": 1, "maximum": 50 },
        "maxMonthlySpendUsd": { "type": "number", "minimum": 1 },
        "seed": { "type": "integer" },
        "k6Resources": { "type": "object" }
      }
    },
    "disasterRecovery": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "stanza": { "type": "string", "minLength": 1 },
        "backupSchedule": { "type": "string", "minLength": 9 },
        "verificationSchedule": { "type": "string", "minLength": 9 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "pvcName": { "type": "string", "minLength": 1 },
        "rtoTargetSeconds": { "type": "integer", "minimum": 60, "maximum": 3600 },
        "rpoTargetSeconds": { "type": "integer", "minimum": 60, "maximum": 900 },
        "s3": {
          "type": "object",
          "properties": {
            "bucket": { "type": "string", "minLength": 3 },
            "primaryRegion": { "type": "string", "minLength": 2 },
            "replicaRegion": { "type": "string", "minLength": 2 },
            "retentionDays": { "type": "integer", "minimum": 7 },
            "objectLockEnabled": { "type": "boolean" }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["logLevel", "devxAggregateOnly", "devxAnonymize"],
      "properties": {
        "logLevel": { "type": "string", "enum": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"] },
        "devxAggregateOnly": { "type": "string", "enum": ["true", "false"] },
        "devxAnonymize": { "type": "string", "enum": ["true", "false"] },
        "otelCaptureMessageContent": { "type": "string", "enum": ["true", "false"] }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "existingSecret": { "type": "string" },
        "create": { "type": "boolean" }
      }
    }
  }
}
