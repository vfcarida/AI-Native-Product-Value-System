{
  "uid": "pvs-genai-overview",
  "title": "GenAI Operations Overview (OTEL SemConv v1.28+)",
  "tags": ["pvs", "genai", "opentelemetry", "llm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Token Usage by Model",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (gen_ai_request_model, gen_ai_token_type) (rate(gen_ai_client_token_usage_sum[5m]))",
          "legendFormat": "{{gen_ai_request_model}} - {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Operation Duration (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(gen_ai_client_operation_duration_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_duration_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(gen_ai_client_operation_duration_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate by System",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum by (gen_ai_system, error_type) (rate(gen_ai_client_operation_error_total[5m]))",
          "legendFormat": "{{gen_ai_system}} - {{error_type}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total GenAI Cost (24h USD)",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "expr": "sum(increase(gen_ai_client_operation_cost_total[24h]))",
          "legendFormat": "24h Spend (USD)"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "currencyUSD"}
      }
    }
  ]
}
