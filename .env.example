# AI-Native Product Value System - Environment Variables Template (EVO-033)
# Copy this file to `.env` (`cp .env.example .env`) and replace placeholders with real values.
# `.env` is excluded from Git via `.gitignore` — NEVER commit real API keys.

# LLM Provider API Keys (example placeholders; omit or set USE_MOCK=1 for the $0 Mock adapter)
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# GEMINI_API_KEY=<your-gemini-api-key>
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
# OLLAMA_BASE_URL=http://localhost:11434

# Runtime & Sandbox Configuration
SANDBOX_PROVIDER=docker
LOG_LEVEL=INFO

# Persistence & Artifact Paths (optional overrides)
# PVS_DB_PATH=pvs.db
# PVS_ARTIFACT_ROOT=artifacts

# Opt-in Live Integration & Evaluation Flags (keep unset in standard CI)
# RUN_REAL_INTEGRATION_TESTS=0
# RUN_REAL_BATCH_TESTS=0
# RUN_REAL_EGRESS_TESTS=0
