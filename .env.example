# AI-Native Product Value System - Environment Variables Template (EVO-033)
# Copy this file to `.env` (`cp .env.example .env`) and replace placeholders with real values.
# `.env` is excluded from Git via `.gitignore` — NEVER commit real API keys.

# HashiCorp Vault Configuration (Production enterprise secrets — PROD-004)
# In production, store all API keys & DB credentials in Vault rather than .env.
# VAULT_ADDR=https://vault.company.internal:8200
# VAULT_AUTH_METHOD=kubernetes          # kubernetes | approle | token
# VAULT_ROLE=product-value-system
# VAULT_NAMESPACE=                      # Optional Vault Enterprise namespace
# VAULT_CACHE_TTL=300                   # In-memory secret cache TTL (seconds)
# ENVIRONMENT=development               # Enables .env fallback when Vault is unavailable

# LLM Provider API Keys (local dev placeholders only; omit or set USE_MOCK=1 for $0 Mock mode)
OPENAI_API_KEY=<your-openai-api-key>
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# GEMINI_API_KEY=<your-gemini-api-key>
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=<your-azure-openai-api-key>
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
# OLLAMA_BASE_URL=http://localhost:11434

# Runtime & Sandbox Configuration
SANDBOX_PROVIDER=docker
# SANDBOX_NETWORK_FILTER_ENABLED=true
# SANDBOX_NETWORK_ALLOWLIST_PATH=config/network_allowlist.yaml
# SANDBOX_NETWORK_FILTER_LOG_DENIED=true
LOG_LEVEL=INFO

# Secret Detection Configuration (optional Presidio ML enhancement: pip install -e ".[security-ml]")
# SECRET_DETECTION_USE_ML=false         # Set true to enable Presidio ML detection
# SECRET_DETECTION_CONFIDENCE=0.7       # Minimum confidence threshold (0.0-1.0)

# Persistence & Artifact Paths (optional overrides)
# PVS_DB_PATH=pvs.db
# PVS_ARTIFACT_ROOT=artifacts

# Opt-in Live Integration & Evaluation Flags (keep unset in standard CI)
# RUN_REAL_INTEGRATION_TESTS=0
# RUN_REAL_BATCH_TESTS=0
# RUN_REAL_EGRESS_TESTS=0

# Vulnerability Scanning (CI/CD — configure SNYK_TOKEN & SLACK_WEBHOOK_URL in GitHub Secrets)
# TRIVY_SEVERITY=CRITICAL,HIGH
# SNYK_SEVERITY_THRESHOLD=high

# Compliance Audit Trail & S3 Glacier Archival (PROD-006)
# Generate a 256-bit key: python -c "import secrets; print(secrets.token_hex(32))"
# AUDIT_SIGNING_KEY=<your-hex-signing-key>
# AUDIT_S3_BUCKET=pvs-audit-archive
# AUDIT_HOT_STORAGE_DAYS=90
# AUDIT_COLD_STORAGE_DAYS=2555

# Distributed Tracing with OpenTelemetry & Jaeger (PROD-007)
# OTEL_SERVICE_NAME=product-value-system
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# OTEL_EXPORTER_OTLP_INSECURE=true      # Set false with TLS in production
# OTEL_TRACES_SAMPLER_ARG=0.1           # 0.1 (10%) in production, 1.0 in development
# OTEL_SDK_DISABLED=false               # Set true to disable trace export immediately

# Alerting & On-Call Automation — AlertManager, PagerDuty & Slack (PROD-008)
# ALERTMANAGER_URL=http://alertmanager.monitoring.svc.cluster.local:9093
# PAGERDUTY_SERVICE_KEY=<your-pagerduty-routing-key>
# SLACK_WEBHOOK_URL=<your-slack-incoming-webhook-url>
# SENDGRID_API_KEY=<your-sendgrid-api-key>
