{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvs.ai/schemas/specification.schema.json",
  "title": "Product Specification",
  "description": "Machine-readable, testable specification for implementation",
  "type": "object",
  "required": ["id", "version", "created", "outcome_id", "functional_requirements", "quality_attributes"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^spec-[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^outcome-[a-z0-9-]+$",
      "description": "Reference to outcome hypothesis"
    },
    "functional_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "acceptance_criteria"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^FR-[0-9]{3}$"
          },
          "description": {"type": "string"},
          "acceptance_criteria": {
            "type": "array",
            "items": {"type": "string"}
          },
          "priority": {
            "type": "string",
            "enum": ["must", "should", "could", "must-have", "should-have", "nice-to-have"]
          },
          "linked_to": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "quality_attributes": {
      "type": "object",
      "properties": {
        "performance": {
          "type": "object",
          "properties": {
            "response_time_p95_ms": {"type": "number"},
            "latency_ms": {"type": "number"},
            "throughput_rps": {"type": "number"}
          }
        },
        "reliability": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "availability_percent": {"type": "number"},
                "error_budget_percent": {"type": "number"}
              }
            },
            {
              "type": "array",
              "items": {"type": "string"}
            }
          ]
        },
        "security": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "authentication_required": {"type": "boolean"},
                "data_classification": {
                  "type": "string",
                  "enum": ["public", "internal", "confidential", "restricted"]
                }
              }
            },
            {
              "type": "array",
              "items": {"type": "string"}
            }
          ]
        },
        "scalability": {
          "oneOf": [
            {"type": "object"},
            {
              "type": "array",
              "items": {"type": "string"}
            }
          ]
        }
      }
    },
    "architecture_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "decision", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^AD(R)?-[0-9]{3}$"},
          "title": {"type": "string"},
          "decision": {"type": "string"},
          "rationale": {"type": "string"},
          "alternatives": {
            "type": "array",
            "items": {"type": "string"}
          },
          "trade_offs": {"type": "string"}
        }
      }
    },
    "testability_criteria": {
      "type": "object",
      "properties": {
        "unit_tests": {
          "type": "array",
          "items": {"type": "string"}
        },
        "integration_tests": {
          "type": "array",
          "items": {"type": "string"}
        },
        "acceptance_tests": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "technical": {
          "type": "array",
          "items": {"type": "string"}
        },
        "operational": {
          "type": "array",
          "items": {"type": "string"}
        },
        "business": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "interfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "contract"],
        "properties": {
          "name": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["REST", "GraphQL", "gRPC", "Queue", "Stream"]
          },
          "contract": {
            "type": "string",
            "description": "OpenAPI spec URL, proto file, etc."
          }
        }
      }
    }
  },
  "additionalProperties": false
}
