{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvs.ai/schemas/evidence.schema.json",
  "title": "Evidence Artifact",
  "description": "Evidence supporting a claim, decision, or quality gate",
  "type": "object",
  "required": ["id", "version", "created", "type", "verdict", "artifacts"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evidence-[a-z0-9-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "type": "string",
      "enum": ["test_result", "review", "evaluation", "measurement", "approval"],
      "description": "Type of evidence"
    },
    "subject_id": {
      "type": "string",
      "description": "ID of artifact being evaluated (spec, code, etc.)"
    },
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "warn", "blocked"],
      "description": "Overall assessment"
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Numeric score (0.0-1.0) if applicable"
    },
    "rationale": {
      "type": "string",
      "description": "Human-readable explanation of verdict"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "mime_type": {"type": "string"}
        }
      },
      "description": "Supporting artifacts (test reports, logs, etc.)"
    },
    "agent_id": {
      "type": "string",
      "description": "Agent that produced this evidence"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "run_id": {"type": "string"},
        "stage": {"type": "string"},
        "duration_seconds": {"type": "number"}
      }
    }
  },
  "additionalProperties": false
}
