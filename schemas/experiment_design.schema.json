{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pvs.ai/schemas/experiment_design.schema.json",
  "title": "Experiment Design",
  "description": "Schema for EVO-016 statistically rigorous A/B experiment designs generated from outcome hypotheses.",
  "type": "object",
  "required": [
    "id",
    "hypothesis",
    "variants",
    "sample_size_per_variant",
    "duration_days",
    "guardrails",
    "stopping_criteria",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^experiment-[a-z0-9-]+$"
    },
    "outcome_id": {
      "type": ["string", "null"]
    },
    "test_type": {
      "type": "string",
      "enum": ["ttest", "chi_square", "bayesian"]
    },
    "hypothesis": {
      "type": "object",
      "required": [
        "null_hypothesis",
        "alternative_hypothesis",
        "primary_metric",
        "baseline_value",
        "expected_value",
        "minimum_detectable_effect",
        "confidence_level",
        "statistical_power"
      ],
      "properties": {
        "null_hypothesis": {"type": "string", "minLength": 1},
        "alternative_hypothesis": {"type": "string", "minLength": 1},
        "primary_metric": {"type": "string", "minLength": 1},
        "baseline_value": {"type": "number"},
        "expected_value": {"type": "number"},
        "minimum_detectable_effect": {"type": "number", "exclusiveMinimum": 0.0},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
        "statistical_power": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1.0},
        "metric_type": {"type": "string", "enum": ["continuous", "proportion"]}
      }
    },
    "variants": {
      "type": "object",
      "required": ["control", "treatment"],
      "properties": {
        "control": {"type": "object"},
        "treatment": {"type": "object"}
      }
    },
    "sample_size_per_variant": {
      "type": "integer",
      "minimum": 1
    },
    "duration_days": {
      "type": "integer",
      "minimum": 1
    },
    "guardrails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "threshold", "direction", "description"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "threshold": {"type": "number"},
          "direction": {"type": "string", "enum": ["increase", "decrease"]},
          "description": {"type": "string"}
        }
      }
    },
    "stopping_criteria": {
      "type": "object",
      "properties": {
        "early_stop_enabled": {"type": "boolean"},
        "early_stop_alpha": {"type": "number"},
        "max_duration_days": {"type": "integer", "minimum": 1},
        "guardrail_violation_action": {"type": "string", "enum": ["abort", "warn"]}
      }
    },
    "created_at": {
      "type": "string"
    }
  }
}
