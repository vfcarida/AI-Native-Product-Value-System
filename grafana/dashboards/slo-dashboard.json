{
  "uid": "pvs-slo-dashboard",
  "title": "Product Value System - SLO Dashboard",
  "description": "Production 28-day SLO compliance, error budgets, multi-window burn rates, and pod saturation (PROD-002).",
  "tags": ["pvs", "slo", "sre", "prometheus", "error-budget"],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "type": "custom",
        "label": "Namespace",
        "query": "product-value-system",
        "current": {
          "text": "product-value-system",
          "value": "product-value-system"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "SLO-01: API Availability (28d)",
      "description": "Target: 99.9% successful (2xx) HTTP requests over a 28-day rolling window.",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{code=~\"2..\",namespace=\"$namespace\"}[28d])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[28d])), 1e-9)",
          "legendFormat": "Availability"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "min": 0.99,
          "max": 1.0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "red", "value": 0.998},
              {"color": "yellow", "value": 0.999},
              {"color": "green", "value": 0.9995}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "SLO-01: Error Budget Remaining (28d)",
      "description": "Percentage of monthly availability error budget (0.1% / 40.32 min per 28d) remaining.",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(clamp_max((0.001 - (1 - sum(rate(http_requests_total{code=~\"2..\",namespace=\"$namespace\"}[28d])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[28d])), 1e-9))) / 0.001 * 100, 100), 0)",
          "legendFormat": "Budget Remaining %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 25},
              {"color": "green", "value": 50}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "SLO-03: API 5xx Error Rate (5m)",
      "description": "Target: < 1% HTTP 5xx server error rate.",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{code=~\"5..\",namespace=\"$namespace\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[5m])), 1e-9)",
          "legendFormat": "5xx Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.005},
              {"color": "red", "value": 0.01}
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "SLO-04: Agent Completion Success Rate (28d)",
      "description": "Target: > 95% of agent runs complete successfully.",
      "type": "stat",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(agent_runs_total{status=\"completed\",namespace=\"$namespace\"}[28d])) / clamp_min(sum(rate(agent_runs_total{namespace=\"$namespace\"}[28d])), 1e-9)",
          "legendFormat": "Agent Success"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.95},
              {"color": "green", "value": 0.97}
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "SLO-02: API Latency p99 (5m)",
      "description": "Target: 99% of requests complete in < 1.0s (critical threshold: 5.0s).",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{namespace=\"$namespace\"}[5m])) by (le))",
          "legendFormat": "HTTP p99"
        },
        {
          "refId": "B",
          "expr": "pvs_latency_p95_seconds{namespace=\"$namespace\"}",
          "legendFormat": "Agent/Model p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 1.0},
              {"color": "red", "value": 5.0}
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Multi-Window Availability Burn Rate (5m vs 1h)",
      "description": "Burn rate multiplier relative to the 0.1% (99.9% SLO) error budget. >10x triggers critical page.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "(1 - sum(rate(http_requests_total{code=~\"2..\",namespace=\"$namespace\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[5m])), 1e-9)) / 0.001",
          "legendFormat": "5m Burn Rate (x)"
        },
        {
          "refId": "B",
          "expr": "(1 - sum(rate(http_requests_total{code=~\"2..\",namespace=\"$namespace\"}[1h])) / clamp_min(sum(rate(http_requests_total{namespace=\"$namespace\"}[1h])), 1e-9)) / 0.001",
          "legendFormat": "1h Burn Rate (x)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 2},
              {"color": "red", "value": 10}
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Control Plane Request Throughput & Active Runs",
      "description": "PVS request rate by status and concurrent active value stream runs.",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pvs_requests_total{namespace=\"$namespace\"}[5m])) by (status)",
          "legendFormat": "Requests/s ({{status}})"
        },
        {
          "refId": "B",
          "expr": "pvs_active_runs{namespace=\"$namespace\"}",
          "legendFormat": "Active Runs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 8,
      "title": "Pod Memory & CPU Throttling Saturation",
      "description": "Resource saturation thresholds (Memory > 90%, CPU throttled > 50%).",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [
        {
          "refId": "A",
          "expr": "container_memory_usage_bytes{namespace=\"$namespace\",container!=\"\"} / clamp_min(container_spec_memory_limit_bytes{namespace=\"$namespace\",container!=\"\"}, 1)",
          "legendFormat": "Memory % ({{pod}})"
        },
        {
          "refId": "B",
          "expr": "rate(container_cpu_cfs_throttled_seconds_total{namespace=\"$namespace\",container!=\"\"}[5m])",
          "legendFormat": "CPU Throttled ({{pod}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.5},
              {"color": "red", "value": 0.9}
            ]
          }
        }
      }
    }
  ]
}
